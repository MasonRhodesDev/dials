#!/bin/bash
# Run dials' hypr-qa scenarios in a QEMU guest (never on a live desktop).
#
#   tests/qa/run                 # every scenario here
#   tests/qa/run users.toml      # one
#
# Builds the release binary, copies it next to the scenarios (their setup
# pushes ./dials into the guest), then runs each through hypr-qa
# (https://github.com/MasonRhodesDev/hypr-qa, $HYPR_QA or ~/repos/hypr-qa).
# The guest profile needs accountsservice and a polkit agent: plain-hyprland
# has both. Exit status: the worst of the runs (0 pass, 1 fail, 2 error).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
hqa=${HYPR_QA:-$HOME/repos/hypr-qa}/bin/hypr-qa

(cd "$repo" && cargo build --release)
target=$(cd "$repo" && cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
install -m 755 "$target/release/dials" "$here/dials"

[ $# -gt 0 ] || set -- "$here"/*.toml
worst=0
for s in "$@"; do
    case $s in /*) ;; *) [ -f "$s" ] || s=$here/$s ;; esac
    rc=0
    nice -n 19 "$hqa" run "$s" || rc=$?
    [ $rc -le $worst ] || worst=$rc
done
exit $worst
