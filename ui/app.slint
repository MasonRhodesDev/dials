// dials — desktop settings. Displays (canvas-first monitor profile editor),
// Power, Help, and More (external settings tools from XDG desktop entries).
// UX: monitor-profiles/.plans/planning/ux_design.md

import { Theme } from "theme.slint";
import {
    KitButton, KitIconButton, KitCheckBox, KitLineEdit, KitComboBox, KitAlignPad,
    KitDisplay, KitMuted, KitTitle, KitLabel, KitWarning,
    KitVStack, KitHStack, KitSpacer,
    KitListRow, KitToolbar, KitHeadingStack, KitField, KitDisclosure,
    KitOverlayBar, KitSidePanel, Panel
} from "widgets.slint";
import { Palette, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { PowerPage } from "power.slint";
import { HelpPage, HelpNode, HelpEdge } from "help.slint";

export { Theme, Palette, HelpNode, HelpEdge }

/// One external settings tool (More page). `section` groups rows.
export struct SettingsEntry {
    name: string,
    comment: string,
    section: string,
}

export struct ProfileRow {
    name: string,
    source: string,
    matched: bool,
    active: bool,
}

export struct CanvasMonitor {
    label: string,
    x: float,
    y: float,
    w: float,
    h: float,
    selected: bool,
    ghost: bool,
    origin: bool,
}

/// Active snap guide (only present while snapped). `vertical` → line at x=`pos`.
export struct CanvasGuide {
    vertical: bool,
    pos: float,
}

export component AppWindow inherits Window {
    title: "Dials";
    preferred-width: 1100px;
    preferred-height: 720px;
    background: Theme.page-bg;

    public function sync-palette() {
        Palette.color-scheme = Theme.mode == "light" ? ColorScheme.light : ColorScheme.dark;
    }

    in-out property <bool> show-editor: false;
    in-out property <string> live-signature: "";
    in-out property <[ProfileRow]> profiles: [];
    in-out property <string> status-text: "";

    in-out property <string> editor-name: "";
    in-out property <string> editor-source: "";
    in-out property <string> editor-badge: "";
    in-out property <bool> editor-dirty: false;
    in-out property <bool> can-promote-shared: false;
    in-out property <bool> renaming-profile: false;
    in-out property <string> rename-draft: "";
    in-out property <[CanvasMonitor]> canvas-monitors: [];
    in-out property <[CanvasGuide]> canvas-guides: [];
    in-out property <int> selected-index: -1;

    in-out property <string> insp-label: "";
    in-out property <[string]> insp-modes: [];
    in-out property <int> insp-mode-index: 0;
    in-out property <string> insp-scale: "1";
    in-out property <string> insp-snap: "";
    in-out property <[string]> insp-rotates: ["0°", "90°", "180°", "270°"];
    in-out property <int> insp-rotate-index: 0;
    in-out property <string> insp-pos-x: "0";
    in-out property <string> insp-pos-y: "0";
    in-out property <bool> insp-enabled: true;
    in-out property <bool> insp-is-origin: false;
    in-out property <bool> show-advanced: false;
    in-out property <bool> helper-snap-edges: true;
    in-out property <bool> helper-snap-centers: true;
    in-out property <string> insp-match: "";
    in-out property <string> warnings: "";
    in-out property <string> canvas-zoom-label: "100%";

    in-out property <int> section: 0;
    in-out property <[SettingsEntry]> entries: [];
    in-out property <string> now-lid: "";
    in-out property <string> now-ac: "";
    in-out property <string> now-battery: "";
    in-out property <string> now-base: "";
    in-out property <string> now-desired: "";
    in-out property <string> now-applied: "";
    in-out property <string> now-override: "";
    in-out property <int> docked-ac-index: 1;
    in-out property <int> ac-index: 1;
    in-out property <int> battery-index: 0;
    in-out property <int> battery-low-index: 0;
    in-out property <string> low-percent: "15";
    in-out property <[string]> lid-sensors: [];
    in-out property <int> lid-sensor-index: 0;
    in-out property <[string]> ac-sensors: [];
    in-out property <int> ac-sensor-index: 0;
    in-out property <[string]> battery-sensors: [];
    in-out property <int> battery-sensor-index: 0;
    in-out property <bool> show-sensors: false;
    in-out property <[HelpNode]> help-lid-nodes: [];
    in-out property <[HelpEdge]> help-lid-muted-edges: [];
    in-out property <[HelpEdge]> help-lid-lit-edges: [];
    in-out property <float> help-lid-width: 1;
    in-out property <float> help-lid-height: 1;
    in-out property <[HelpNode]> help-power-nodes: [];
    in-out property <[HelpEdge]> help-power-muted-edges: [];
    in-out property <[HelpEdge]> help-power-lit-edges: [];
    in-out property <float> help-power-width: 1;
    in-out property <float> help-power-height: 1;
    in-out property <[HelpNode]> help-display-nodes: [];
    in-out property <[HelpEdge]> help-display-muted-edges: [];
    in-out property <[HelpEdge]> help-display-lit-edges: [];
    in-out property <float> help-display-width: 1;
    in-out property <float> help-display-height: 1;
    in-out property <string> help-status-text: "";
    in-out property <string> help-lid-now: "";
    in-out property <string> help-power-now: "";
    in-out property <string> help-display-now: "";

    callback open-profile(int);
    callback open-current-desk();
    callback back-to-list();
    callback save-profile();
    callback promote-to-shared();
    callback rename-profile(string);
    callback select-monitor(int);
    callback align-to-neighbor(int);
    callback set-as-origin();
    callback insp-mode-changed(int);
    callback insp-scale-changed(string);
    callback insp-rotate-changed(int);
    callback insp-pos-changed(string, string);
    callback insp-enabled-changed(bool);
    callback canvas-drag(int, float, float);
    callback canvas-drag-end();
    callback canvas-resized(float, float);
    callback canvas-zoom(float, float, float);
    callback canvas-zoom-step(float);
    callback canvas-fit();
    callback canvas-pan(float, float);
    callback canvas-pan-begin(float, float);
    callback canvas-pan-move(float, float);
    callback canvas-pan-end();
    callback policy-changed();
    callback low-percent-changed(string);
    callback sensor-lid-changed(int);
    callback sensor-ac-changed(int);
    callback sensor-battery-changed(int);
    callback override-set(string);
    callback override-clear();
    callback override-cycle();
    callback section-changed(int);
    callback telemetry-wake();
    callback launch-entry(int);

    // Always-present root plane. Conditional pages are absolute-fill (if-alone shrink-wraps).
    Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.page-bg;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            KitToolbar {
                KitButton {
                    text: "Displays";
                    primary: root.section == 0;
                    clicked => {
                        root.section = 0;
                        root.section-changed(0);
                    }
                }
                KitButton {
                    text: "Power";
                    primary: root.section == 1;
                    clicked => {
                        root.section = 1;
                        root.section-changed(1);
                    }
                }
                KitButton {
                    text: "Help";
                    primary: root.section == 2;
                    clicked => {
                        root.section = 2;
                        root.section-changed(2);
                    }
                }
                KitButton {
                    text: "More";
                    primary: root.section == 3;
                    clicked => {
                        root.section = 3;
                        root.section-changed(3);
                    }
                }
                KitSpacer { axis: "horizontal"; }
            }

            Rectangle {
                vertical-stretch: 1;
                width: 100%;

    if root.section == 0 && !root.show-editor: VerticalBox {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            padding: 0;
            spacing: Theme.space-lg;

            KitDisplay { text: "Profiles"; }
            KitMuted {
                text: "Historical configurations. Live desk is edited separately.";
                wrap-text: true;
            }
            KitMuted {
                text: root.live-signature;
                wrap-text: true;
            }

            KitHStack {
                gap: "form";
                vertical-stretch: 0;
                KitButton {
                    text: "Edit current desk";
                    primary: true;
                    clicked => { root.open-current-desk(); }
                }
            }

            KitVStack {
                gap: "tight";
                vertical-stretch: 1;
                width: 100%;
                horizontal-stretch: 1;

                for p[i] in root.profiles: KitListRow {
                    title: p.name;
                    meta: p.source;
                    matched: p.matched;
                    active: p.active;
                    clicked => { root.open-profile(i); }
                }

                KitSpacer { axis: "vertical"; }
            }

            KitMuted { text: root.status-text; }
        }

    if root.section == 0 && root.show-editor: VerticalBox {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            padding: 0;
            spacing: Theme.space-md;

        KitToolbar {
            KitButton {
                text: "← Profiles";
                min-width: 96px;
                max-width: 96px;
                clicked => { root.back-to-list(); }
            }

            KitHeadingStack {
                // Claim the bounded space between the leading and trailing actions.
                horizontal-stretch: 1;
                subtitle: root.editor-badge
                    + " · "
                    + root.editor-source
                    + (root.editor-dirty ? " · Modified" : "");

                if !root.renaming-profile: TouchArea {
                    mouse-cursor: pointer;
                    horizontal-stretch: 1;
                    width: 100%;
                    clicked => {
                        root.rename-draft = root.editor-name;
                        root.renaming-profile = true;
                    }
                    KitTitle {
                        text: root.editor-name;
                        width: 100%;
                        horizontal-alignment: left;
                    }
                }
                if root.renaming-profile: KitHStack {
                    gap: "form";
                    center: true;
                    width: 100%;
                    horizontal-stretch: 1;
                    TextInput {
                        text <=> root.rename-draft;
                        color: Theme.fg;
                        font-size: Theme.font-title;
                        font-weight: Theme.font-weight-semibold;
                        single-line: true;
                        horizontal-stretch: 1;
                        accepted => {
                            root.rename-profile(self.text);
                            root.renaming-profile = false;
                        }
                    }
                    KitButton {
                        text: "Done";
                        small: true;
                        primary: true;
                        clicked => {
                            root.rename-profile(root.rename-draft);
                            root.renaming-profile = false;
                        }
                    }
                    KitButton {
                        text: "Cancel";
                        small: true;
                        clicked => { root.renaming-profile = false; }
                    }
                }
            }

            if root.can-promote-shared: KitButton {
                text: "Promote to shared";
                min-width: 156px;
                max-width: 156px;
                clicked => { root.promote-to-shared(); }
            }
            KitButton {
                text: "Save";
                min-width: 68px;
                max-width: 68px;
                primary: true;
                enabled: root.editor-dirty;
                clicked => { root.save-profile(); }
            }
        }

        HorizontalBox {
            spacing: Theme.space-md;
            vertical-stretch: 1;

            Panel {
                variant: "canvas";
                clip: true;
                horizontal-stretch: 6;

                changed width => {
                    root.canvas-resized(self.width / 1px, self.height / 1px);
                }
                changed height => {
                    root.canvas-resized(self.width / 1px, self.height / 1px);
                }

                // Clip tiles/guides only — not the overlay (Panel clip + layout text = Slint #10499).
                Rectangle {
                    width: 100%;
                    height: 100%;
                    clip: true;

                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: default;
                    scroll-event(ev) => {
                        root.canvas-zoom(
                            ev.delta-y / 1px,
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                        );
                        accept
                    }
                    changed pressed => {
                        if self.pressed {
                            root.canvas-pan-begin(self.mouse-x / 1px, self.mouse-y / 1px);
                        } else {
                            root.canvas-pan-end();
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.canvas-pan-move(self.mouse-x / 1px, self.mouse-y / 1px);
                        }
                    }
                }

                for m[i] in root.canvas-monitors: Rectangle {
                    x: m.x * 1px;
                    y: m.y * 1px;
                    width: m.w * 1px;
                    height: m.h * 1px;
                    border-radius: Theme.radius-xs;
                    background: m.ghost
                        ? Theme.tile-bg.with-alpha(Theme.ghost-alpha)
                        : (m.selected ? Theme.tile-selected : Theme.tile-bg);
                    border-width: m.selected ? Theme.border-width-strong : Theme.border-width;
                    border-color: m.selected ? Theme.accent : Theme.border;

                    Text {
                        text: m.label + (m.origin ? " ★" : "");
                        color: Theme.fg;
                        font-size: Theme.font-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        width: parent.width;
                        height: parent.height;
                    }

                    TouchArea {
                        mouse-cursor: grab;
                        clicked => { root.select-monitor(i); }
                        moved => {
                            if self.pressed {
                                root.canvas-drag(
                                    i,
                                    m.x + self.mouse-x / 1px,
                                    m.y + self.mouse-y / 1px,
                                );
                            }
                        }
                        changed pressed => {
                            if !self.pressed {
                                root.canvas-drag-end();
                            }
                        }
                        scroll-event(ev) => {
                            root.canvas-zoom(
                                ev.delta-y / 1px,
                                m.x + self.mouse-x / 1px,
                                m.y + self.mouse-y / 1px,
                            );
                            accept
                        }
                    }
                }

                for g in root.canvas-guides: Rectangle {
                    x: g.vertical ? g.pos * 1px : 0px;
                    y: g.vertical ? 0px : g.pos * 1px;
                    width: g.vertical ? Theme.border-width : parent.width;
                    height: g.vertical ? parent.height : Theme.border-width;
                    background: Theme.accent;
                }
                }

                KitOverlayBar {
                    x: parent.width - self.width - Theme.space-md;
                    y: Theme.space-md;
                    width: zoom-row.min-width;
                    height: zoom-row.min-height;

                    zoom-row := KitHStack {
                        gap: "tight";
                        center: true;
                        padding: Theme.space-xs;
                        KitIconButton {
                            text: "−";
                            small: true;
                            clicked => { root.canvas-zoom-step(-1); }
                        }
                        KitMuted {
                            text: root.canvas-zoom-label;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            min-width: Theme.metric-min-width;
                        }
                        KitIconButton {
                            text: "+";
                            small: true;
                            clicked => { root.canvas-zoom-step(1); }
                        }
                        KitButton {
                            text: "Fit";
                            small: true;
                            clicked => { root.canvas-fit(); }
                        }
                    }
                }
            }

            KitSidePanel {
                ScrollView {
                    width: 100%;
                    height: 100%;
                    KitVStack {
                        gap: "form";
                        padding: Theme.space-md;

                        KitTitle {
                            text: root.insp-label == "" ? "Select a monitor" : root.insp-label;
                        }

                        KitField {
                            label: "Mode";
                            KitComboBox {
                                model: root.insp-modes;
                                current-index: root.insp-mode-index;
                                selected(i) => { root.insp-mode-changed(i); }
                            }
                        }

                        KitField {
                            label: "Scale";
                            hint: root.insp-snap;
                            KitLineEdit {
                                text: root.insp-scale;
                                edited(t) => { root.insp-scale-changed(t); }
                            }
                        }

                        KitField {
                            label: "Rotate";
                            KitComboBox {
                                model: root.insp-rotates;
                                current-index: root.insp-rotate-index;
                                selected(i) => { root.insp-rotate-changed(i); }
                            }
                        }

                        KitField {
                            label: "Position";
                            KitHStack {
                                gap: "tight";
                                KitLineEdit {
                                    text: root.insp-pos-x;
                                    edited(t) => { root.insp-pos-changed(t, root.insp-pos-y); }
                                }
                                KitLineEdit {
                                    text: root.insp-pos-y;
                                    edited(t) => { root.insp-pos-changed(root.insp-pos-x, t); }
                                }
                            }
                        }

                        KitVStack {
                            gap: "tight";
                            vertical-stretch: 0;
                            KitButton {
                                text: root.insp-is-origin ? "Origin (0×0)" : "Set as origin (0×0)";
                                horizontal-stretch: 1;
                                enabled: root.selected-index >= 0 && !root.insp-is-origin;
                                clicked => { root.set-as-origin(); }
                            }
                            KitLabel {
                                text: "Rebases layout to 0×0 for X11 / Xwayland.";
                                wrap: word-wrap;
                            }
                        }

                        KitField {
                            label: "Helpers";
                            KitCheckBox {
                                text: "Snap edges while dragging";
                                checked: root.helper-snap-edges;
                                toggled(v) => { root.helper-snap-edges = v; }
                            }
                            KitCheckBox {
                                text: "Snap centers while dragging";
                                checked: root.helper-snap-centers;
                                toggled(v) => { root.helper-snap-centers = v; }
                            }
                            KitAlignPad {
                                enabled: root.selected-index >= 0;
                                place(op) => { root.align-to-neighbor(op); }
                            }
                        }

                        KitCheckBox {
                            text: "Enabled";
                            checked: root.insp-enabled;
                            toggled(v) => { root.insp-enabled-changed(v); }
                        }

                        KitDisclosure {
                            label: "Match / advanced";
                            open <=> root.show-advanced;
                        }
                        if root.show-advanced: KitLabel {
                            text: root.insp-match;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        KitWarning { text: root.warnings; }
        KitMuted { text: root.status-text; }
        }

    if root.section == 1: ScrollView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            PowerPage {
                now-lid: root.now-lid;
                now-ac: root.now-ac;
                now-battery: root.now-battery;
                now-base: root.now-base;
                now-desired: root.now-desired;
                now-applied: root.now-applied;
                now-override: root.now-override;
                docked-ac-index <=> root.docked-ac-index;
                ac-index <=> root.ac-index;
                battery-index <=> root.battery-index;
                battery-low-index <=> root.battery-low-index;
                low-percent <=> root.low-percent;
                lid-sensors: root.lid-sensors;
                lid-sensor-index <=> root.lid-sensor-index;
                ac-sensors: root.ac-sensors;
                ac-sensor-index <=> root.ac-sensor-index;
                battery-sensors: root.battery-sensors;
                battery-sensor-index <=> root.battery-sensor-index;
                show-sensors <=> root.show-sensors;
                status-text: root.status-text;
                policy-changed => { root.policy-changed(); }
                low-percent-changed(t) => { root.low-percent-changed(t); }
                sensor-lid-changed(i) => { root.sensor-lid-changed(i); }
                sensor-ac-changed(i) => { root.sensor-ac-changed(i); }
                sensor-battery-changed(i) => { root.sensor-battery-changed(i); }
                override-set(p) => { root.override-set(p); }
                override-clear => { root.override-clear(); }
                override-cycle => { root.override-cycle(); }
            }
        }

    if root.section == 2: ScrollView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            HelpPage {
                status-text: root.help-status-text;
                lid-now: root.help-lid-now;
                power-now: root.help-power-now;
                display-now: root.help-display-now;
                lid-nodes: root.help-lid-nodes;
                lid-muted-edges: root.help-lid-muted-edges;
                lid-lit-edges: root.help-lid-lit-edges;
                lid-width: root.help-lid-width;
                lid-height: root.help-lid-height;
                power-nodes: root.help-power-nodes;
                power-muted-edges: root.help-power-muted-edges;
                power-lit-edges: root.help-power-lit-edges;
                power-width: root.help-power-width;
                power-height: root.help-power-height;
                display-nodes: root.help-display-nodes;
                display-muted-edges: root.help-display-muted-edges;
                display-lit-edges: root.help-display-lit-edges;
                display-width: root.help-display-width;
                display-height: root.help-display-height;
            }
        }

    if root.section == 3: ScrollView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            VerticalBox {
                padding: 0;
                spacing: Theme.space-lg;
                alignment: start;

                KitDisplay { text: "More settings"; }
                KitMuted {
                    text: "Other settings tools installed on this system. Each opens in its own window.";
                    wrap-text: true;
                }
                if root.entries.length == 0: KitMuted {
                    text: "No settings tools found. A tool is listed when its desktop entry has Categories=Settings; or X-Dials-Section=<section>.";
                    wrap-text: true;
                }

                KitVStack {
                    gap: "tight";
                    width: 100%;
                    for e[i] in root.entries: VerticalLayout {
                        spacing: Theme.space-sm;
                        // Section heading when it differs from the previous row.
                        if i == 0 || root.entries[i - 1].section != e.section: KitTitle {
                            text: e.section;
                        }
                        KitListRow {
                            title: e.name;
                            meta: e.comment;
                            clicked => { root.launch-entry(i); }
                        }
                    }
                }

                KitMuted { text: root.status-text; }
            }
        }
            }
        }
    }
}
